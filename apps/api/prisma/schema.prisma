// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// =======================
// GENERATOR & DATASOURCE
// =======================
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =======================
// AUTHENTICATION & USERS
// =======================

// User: Entité centrale représentant une personne utilisant l’application. 
// Elle sert de point d’entrée pour l’authentification et les rôles (Admin / Member).
model User {
  uid       String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String?
  image String?

  Credentials  Credentials?  @relation
  AuthProvider AuthProvider? @relation
  Admin        Admin?        @relation
  Member       Member?       @relation
}

// Credentials: Stocke les informations de connexion classiques (email / mot de passe).
// Séparé de User pour l'ajout d’autres méthodes d’authentification plus tard (avec provider comme Google par ex).
model Credentials {
  uid  String @id
  User User   @relation(fields: [uid], references: [uid])

  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AuthProvider: Indique le type de fournisseur d’authentification utilisé par l’utilisateur 
// (ex : credentials, OAuth, etc.).
model AuthProvider {
  uid  String           @id
  type AuthProviderType
  User User             @relation(fields: [uid], references: [uid])
}

enum AuthProviderType {
  CREDENTIALS
}

// Admin: Rôle avec droits d’administration.
// Permet de gérer et d’enrichir le catalogue musical (groupes, albums, métadonnées).
model Admin {
  uid  String @id
  User User   @relation(fields: [uid], references: [uid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Member: Rôle utilisateur standard. Permet de gérer une collection personnelle d’albums physiques.
model Member {
  uid  String @id
  User User   @relation(fields: [uid], references: [uid])

  displayName String?

  CollectionItems CollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// MUSIC STYLES
// =======================

// MusicStyle: Représente un style musical (Rock, Metal, Jazz…).
//Permet de classer les groupes et de générer des recommandations.
model MusicStyle {
  id   Int @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Groups GroupStyle[]
}

// =======================
// GROUPS & ARTISTS
// =======================

// Group: Représente un groupe ou un artiste.
// Contient la description, l’image, les styles associés et la discographie complète.
model Group {
  id          Int @id @default(autoincrement())
  name        String
  description String?
  image       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Styles     GroupStyle[]
  Albums     Album[]
  Musicians  GroupMusician[]
}

// GroupStyle: Table de jointure entre Group et MusicStyle.
// Permet d’associer plusieurs styles à un groupe sans duplication.
model GroupStyle {
  groupId Int
  styleId Int

  Group      Group      @relation(fields: [groupId], references: [id])
  MusicStyle MusicStyle @relation(fields: [styleId], references: [id])

  @@id([groupId, styleId])
}

// =======================
// MUSICIANS & TIMELINE
// =======================

// GroupMusician: Représente un musicien d’un groupe.
// Inclut son rôle et sa période d’activité (timeline du groupe) et ses instruments.
model GroupMusician {
  id        Int @id @default(autoincrement())
  name      String
  role      String
  startYear Int?
  endYear   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId Int
  Group   Group @relation(fields: [groupId], references: [id])

  Instruments GroupMusicianInstrument[]
}

model Instrument {
  id   Int @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Musicians GroupMusicianInstrument[]
}

model GroupMusicianInstrument {
  groupMusicianId Int
  instrumentId    Int

  GroupMusician GroupMusician @relation(fields: [groupMusicianId], references: [id])
  Instrument    Instrument    @relation(fields: [instrumentId], references: [id])

  @@id([groupMusicianId, instrumentId])
}

// =======================
// ALBUMS & TRACKS
// =======================

// Album: Représente un album dans le catalogue global.
// Existe indépendamment de la possession par un utilisateur.
model Album {
  id          Int @id @default(autoincrement())
  title       String
  releaseDate DateTime?
  studio      String?
  coverUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId Int
  Group   Group @relation(fields: [groupId], references: [id])

  Tracks    Track[]
  Versions  AlbumVersion[]
  Sources   ExternalSource[]
}

// Track: Représente une piste d’un album.
//Permet une tracklist complète avec ordre et durée.
model Track {
  id       Int @id @default(autoincrement())
  title    String
  position Int
  duration Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albumId Int
  Album   Album @relation(fields: [albumId], references: [id])
}

// =======================
// ALBUM VERSIONS / SUPPORTS
// =======================

// AlbumVersion: Représente une version physique ou éditoriale d’un album
// (Standard, Deluxe, Remaster, Vinyle, CD, etc.).
model AlbumVersion {
  id     Int @id @default(autoincrement())
  name   String
  format SupportType
  year   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albumId Int
  Album   Album @relation(fields: [albumId], references: [id])

  CollectionItems CollectionItem[]
}

enum SupportType {
  VINYL
  CD
  CASSETTE
  DIGITAL
  BOX
}

// =======================
// USER COLLECTION
// =======================

// CollectionItem: Collection personnelle. Lien entre un Member et un AlbumVersion.
// Représente un album réellement possédé par l’utilisateur.
model CollectionItem {
  id Int @id @default(autoincrement())

  memberId String
  Member   Member @relation(fields: [memberId], references: [uid])

  albumVersionId Int
  AlbumVersion   AlbumVersion @relation(fields: [albumVersionId], references: [id])

  condition Condition
  notes     String?

  Purchase PurchaseInfo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Condition {
  MINT
  VERY_GOOD
  GOOD
  FAIR
  POOR
}

// =======================
// PURCHASE INFO
// =======================

// PurchaseInfo: Informations d’achat associées à un album possédé (prix, date, lieu).
model PurchaseInfo {
  id    Int @id @default(autoincrement())
  price Float?
  place String?
  date  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionItemId Int @unique
  CollectionItem   CollectionItem @relation(fields: [collectionItemId], references: [id])
}

// =======================
// EXTERNAL SOURCES (APIs)
// =======================

// ExternalSource: Intégrations externes. Lien entre une entité interne (album) et une source externe
// (MusicBrainz, Discogs, Spotify, etc.).
model ExternalSource {
  id          Int @id @default(autoincrement())
  source      ExternalSourceType
  externalId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albumId Int?
  Album   Album? @relation(fields: [albumId], references: [id])
}

enum ExternalSourceType {
  MUSICBRAINZ
  DISCOGS
  AUDIO_DB
  SPOTIFY
}